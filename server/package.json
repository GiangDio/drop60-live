{
  "name": "drop60-live-server",
  "version": "1.0.0",
  "description": "DROP60.LIVE Realtime Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare-db": "node scripts/prepare-db.js",
    "build": "npm run clean && npm run prepare-db && prisma generate && tsc",
    "start": "node scripts/prepare-db.js && prisma generate && prisma db push --accept-data-loss && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-tts-api": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2"
  }
}
